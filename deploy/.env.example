# ══════════════════════════════════════════════════════════════════
#  İstehsal parametrləri — NÜMUNƏ fayl
#
#  Serverdə:  cp .env.example .env   →  .env-i doldurun  →  compose işə salın
#
#  ⚠ `.env` faylı git-ə DÜŞMÜR və heç kimə göndərilmir.
#    Aşağıdakı <...> yerlərini serverdə öz əlinizlə doldurun.
# ══════════════════════════════════════════════════════════════════

# ── Baza ──────────────────────────────────────────────────────────
DB_NAME=mmuisp
# Güclü parol. Generasiya: openssl rand -base64 24
DB_ROOT_PASSWORD=<güclü_parol_yazın>

# ── JWT (token imzası) ────────────────────────────────────────────
# ⚠ MÜTLƏQ yeni açar generasiya edin: openssl rand -base64 48
#   Köhnə açar repo tarixçəsində qaldığı üçün kompromitasiya sayılır.
JWT_KEY=<openssl_rand_base64_48_nəticəsi>
JWT_ISSUER=MmuIspApi
JWT_AUDIENCE=MmuIspFrontend
# Sessiya müddəti (dəqiqə) — 480 = 8 saat
JWT_EXPIRY_MINUTES=480

# ── İlk superadmin ────────────────────────────────────────────────
# Yalnız baza tamamilə boş olduqda bir dəfə istifadə olunur.
# İlk girişdən sonra admin paneldən dəyişdirin.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=<ilk_giriş_parolu>
SEED_ADMIN_EMAIL=admin@mmu.az

# ── CORS (adətən boş qalır) ───────────────────────────────────────
# Boş buraxılsa: lokal maşın + daxili şəbəkə (10.x, 172.16-31.x, 192.168.x)
# mənşələrinə icazə verilir — LAN quraşdırması üçün doğru davranış budur.
# nginx arxasında sorğular eyni mənşədən getdiyi üçün bu onsuz da işə düşmür.
# Yalnız tətbiq internetə açılırsa konkret siyahı yazın:
#   CORS_ALLOWED_ORIGINS=https://isp.mmu.az,https://www.isp.mmu.az
CORS_ALLOWED_ORIGINS=

# ── Ümumi ─────────────────────────────────────────────────────────
TZ=Asia/Baku
# Swagger və detallı xəta səhifələri lazımdırsa: Development
ASPNETCORE_ENVIRONMENT=Production
